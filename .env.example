# ==============================================================================
# PHANTOM-X Environment Configuration Template
# Autonomous Application Security Intelligence
# DO NOT COMMIT REAL CREDENTIALS IN SOURCE CONTROL
# ==============================================================================

# Core Application Settings
PROJECT_NAME="PHANTOM-X"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="change-me-to-a-secure-random-secret-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
# For local dev without docker, can use sqlite: sqlite+aiosqlite:///./phantom_x.db
DATABASE_URL="postgresql+asyncpg://phantom:phantom_secret@localhost:5432/phantom_x_db"
DATABASE_URL_SYNC="postgresql+psycopg2://phantom:phantom_secret@localhost:5432/phantom_x_db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="phantom"
POSTGRES_PASSWORD="phantom_secret"
POSTGRES_DB="phantom_x_db"

# Redis & Background Tasks (Celery)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# AI Engine - Modular LLM Provider Abstraction
# Supported: "mock", "openai", "anthropic", "gemini"
LLM_PROVIDER="mock"
DEFAULT_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# AI Provider API Keys (leave empty or fill as needed)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Security Testing Engine & Safety Policy Engine
# Mode: "OBSERVE" (safe passive), "ACTIVE_VERIFY" (controlled checks), "ATTACK_SIMULATION" (authorized only)
EXECUTION_MODE="OBSERVE"
STRICT_TARGET_AUTHORIZATION=true
# Comma-separated list of explicitly authorized target domains / IP subnets
ALLOWED_TARGET_HOSTS="localhost,127.0.0.1,api.example-target.local"
MAX_CONCURRENT_SECURITY_TESTS=5
DEFAULT_RATE_LIMIT_RPS=10
ENFORCE_SYNTHETIC_DATA_ONLY=true

# External Integrations (Optional)
ZAP_ENABLED=false
ZAP_API_URL="http://localhost:8080"
ZAP_API_KEY=""
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER="chromium"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_WS_BASE_URL="ws://localhost:8000/api/v1/ws"

